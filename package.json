{
  "name": "grand-livre",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first \"vite --port 5190 --strictPort\" \"wait-on tcp:5190 && electron .\"",
    "electron:build": "vite build && electron-builder --config electron-builder.config.cjs",
    "electron:dist": "npm run electron:build",
    "test": "node tests/vision.test.mjs && node tests/tableReader.test.mjs && node tests/adversaires.test.mjs && node tests/ecranFin.test.mjs && node tests/mainEnDirect.test.mjs && node tests/apprentissageAuto.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1",
    "wait-on": "^9.1.0"
  }
}
