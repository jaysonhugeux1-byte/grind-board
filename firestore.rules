rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // L'abonnement est vérifié via un CLAIM du jeton d'authentification, posé par
    // l'extension Stripe depuis ses webhooks (donc côté serveur, infalsifiable).
    //
    // Pourquoi un claim et pas une lecture de document : les règles facturent
    // chaque get() comme une lecture ET sont limitées à 20 get() par requête
    // multi-documents. Un import écrit par lots de 100 mains — une lecture par
    // document ferait exploser cette limite. Un claim ne coûte rien et n'a
    // aucune limite.
    function isSubscribed() {
      return isSignedIn()
        && 'stripeRole' in request.auth.token
        && request.auth.token.stripeRole != null;
    }

    // Données de l'utilisateur (mains, texte brut, mouvements de bankroll, réglages).
    //
    // La LECTURE reste ouverte même sans abonnement actif : un abonnement expiré
    // ne doit jamais donner l'impression que les données ont été perdues. Seul
    // l'ajout de nouvelles données demande un abonnement.
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isSubscribed();
    }

    // --- Collections gérées par l'extension Stripe ---
    // L'extension écrit ces documents via ses Cloud Functions (droits admin, les
    // règles ne s'y appliquent pas). Ici on autorise seulement ce que le client
    // doit pouvoir faire : lire son propre abonnement, et demander une session
    // de paiement.
    match /customers/{uid} {
      allow read: if isOwner(uid);

      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
    }

    // Catalogue des offres, synchronisé depuis Stripe : ce ne sont que des noms
    // et des tarifs publics, lisibles par n'importe quel utilisateur connecté.
    match /products/{id} {
      allow read: if isSignedIn();
      match /prices/{priceId} {
        allow read: if isSignedIn();
      }
    }
  }
}
